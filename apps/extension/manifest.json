{
  "manifest_version": 3,
  "name": "CareerCrawl Saver",
  "version": "0.1.0",
  "description": "One-click save the current job posting to CareerCrawl.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Save to CareerCrawl"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html"
}
